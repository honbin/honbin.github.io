---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // Markdown pages (layout: BaseLayout) receive their metadata here instead.
  frontmatter?: {
    title: string;
    description?: string;
    image?: string;
  };
}

// Markdown pages pass metadata under `frontmatter`; .astro pages pass flat props.
const { title, description, image = '/images/honbin.jpg' } = Astro.props.frontmatter ?? Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="honbin" />
    <meta property="og:image" content={new URL(image, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrapper">
        <a href="/" class="site-logo">honb.in</a>
        <nav>
          <a href="/profile/">Profile</a>
          <a href="/blog/">Blog</a>
        </nav>
      </div>
    </header>
    <main class="wrapper">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrapper">&copy; honbin</div>
    </footer>
  </body>
</html>
