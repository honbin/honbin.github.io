---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedPosts } from '../../utils/posts';

export async function getStaticPaths({ paginate }) {
  return paginate(await getSortedPosts(), { pageSize: 10 });
}

const { page } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeZone: 'Asia/Tokyo' });
---

<BaseLayout title="Blog | honbin" description="honbin のブログ">
  <div class="blog-header">
    <h1>Blog</h1>
    <a class="feed-link" href="/rss.xml">RSS</a>
  </div>
  {
    page.data.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="post-list">
        {page.data.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>
              {dateFmt.format(post.data.pubDate)}
            </time>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
  {
    page.lastPage > 1 && (
      <nav class="pager">
        {page.url.prev ? <a href={page.url.prev}>← 新しい記事</a> : <span />}
        <span class="pager-pos">{page.currentPage} / {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next}>古い記事 →</a> : <span />}
      </nav>
    )
  }
</BaseLayout>
