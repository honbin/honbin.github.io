---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeZone: 'Asia/Tokyo' });
---

<BaseLayout title="Blog | honbin" description="honbin のブログ">
  <div class="blog-header">
    <h1>Blog</h1>
    <a class="feed-link" href="/rss.xml">RSS</a>
  </div>
  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>
              {dateFmt.format(post.data.pubDate)}
            </time>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
