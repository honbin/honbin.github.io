---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const dateFmt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeZone: 'Asia/Tokyo' });
---

<BaseLayout title="honbin" description="my profile" image="/images/honbin-icon.png">
  <h1>Satoshi Honda</h1>
  <img src="/images/honbin.svg" alt="honb.in" width="160" height="160" />
  <p><a href="/profile/">View profile →</a></p>

  <h2>Recent posts</h2>
  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>
              {dateFmt.format(post.data.pubDate)}
            </time>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          </li>
        ))}
      </ul>
    )
  }
  <p><a href="/blog/">All posts →</a></p>

  <h2>Links</h2>
  <ul>
    <li>Mail: <a href="mailto:bin.honda@gmail.com">bin.honda@gmail.com</a></li>
    <li>GitHub: <a href="https://github.com/honbin">honbin</a></li>
    <li>過去ログ: <a href="https://honbin.hatenablog.com">記録 (Hatena)</a></li>
  </ul>
</BaseLayout>
