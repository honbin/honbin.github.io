---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const dateFmt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium' });
---

<BaseLayout title="honbin" description="my profile">
  <img src="/images/honbin.jpg" alt="honbin" width="200" />

  <h2>Profile</h2>
  <dl>
    <dt>Name: Satoshi Honda</dt>
    <dt>Mail: bin.honda@gmail.com</dt>
  </dl>

  <h2>Links</h2>
  <ul>
    <li>Github: <a href="https://github.com/honbin">honbin</a></li>
    <li>過去ログ: <a href="https://honbin.hatenablog.com">記録 (Hatena)</a></li>
  </ul>

  <h2>Recent posts</h2>
  {
    posts.length === 0 ? (
      <p>まだ記事がありません。</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>
              {dateFmt.format(post.data.pubDate)}
            </time>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
  <p><a href="/blog">すべての記事 →</a></p>
</BaseLayout>
